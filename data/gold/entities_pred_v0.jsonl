{"id": "gs-011", "text": "The Project 2025 Advisory Board\nAlliance Defending Freedom\nCenter for Immigration Studies\nThe Heritage Foundation", "extractions": [{"extraction_class": "organization", "extraction_text": "The Project 2025 Advisory Board", "attributes": {"role": "advisory group"}}, {"extraction_class": "organization", "extraction_text": "Alliance Defending Freedom", "attributes": {"type": "legal advocacy organization"}}, {"extraction_class": "organization", "extraction_text": "Center for Immigration Studies", "attributes": {"type": "think tank"}}, {"extraction_class": "organization", "extraction_text": "The Heritage Foundation", "attributes": {"type": "think tank"}}]}
{"id": "gs-012", "text": "Stephen Moore is currently a senior economist at FreedomWorks, a Distinguished Fellow at The Heritage Foundation, and a Fox News analyst.", "extractions": [{"extraction_class": "person", "extraction_text": "Stephen Moore", "attributes": {"role": "senior economist, Distinguished Fellow, analyst"}}, {"extraction_class": "organization", "extraction_text": "FreedomWorks", "attributes": {"type": "advocacy group"}}, {"extraction_class": "organization", "extraction_text": "The Heritage Foundation", "attributes": {"type": "think tank"}}, {"extraction_class": "organization", "extraction_text": "Fox News", "attributes": {"type": "media organization"}}]}
{"id": "gs-013", "text": "Mora Namdar is an attorney and Senior Fellow at the American Foreign Policy Council. Mora served at the U.S. State Department and at the U.S. Agency for Global Media.", "extractions": [{"extraction_class": "person", "extraction_text": "Mora Namdar", "attributes": {"role": "attorney and Senior Fellow"}}, {"extraction_class": "organization", "extraction_text": "American Foreign Policy Council", "attributes": {"type": "think tank"}}, {"extraction_class": "government_agency", "extraction_text": "U.S. State Department", "attributes": {"level": "federal"}}, {"extraction_class": "government_agency", "extraction_text": "U.S. Agency for Global Media", "attributes": {"level": "federal"}}]}
{"id": "gs-014", "text": "Peter Navarro served as Director of the Office of Trade and Manufacturing Policy and Defense Production Act Policy Coordinator.", "extractions": [{"extraction_class": "person", "extraction_text": "Peter Navarro", "attributes": {"role": "Director"}}, {"extraction_class": "government_agency", "extraction_text": "Office of Trade and Manufacturing Policy", "attributes": {"level": "federal", "context": "Executive Office of the President"}}, {"extraction_class": "legal_reference", "extraction_text": "Defense Production Act", "attributes": {"kind": "federal law"}}]}
{"id": "gs-015", "text": "William Perry Pendley was born in Cheyenne, Wyoming and later led the Bureau of Land Management.", "extractions": [{"extraction_class": "person", "extraction_text": "William Perry Pendley", "attributes": {"role": "former government official"}}, {"extraction_class": "location", "extraction_text": "Cheyenne", "attributes": {"kind": "city"}}, {"extraction_class": "location", "extraction_text": "Wyoming", "attributes": {"kind": "state"}}, {"extraction_class": "government_agency", "extraction_text": "Bureau of Land Management", "attributes": {"level": "federal", "parent_department": "Department of the Interior"}}]}
{"id": "gs-016", "text": "Max Primorac was acting Chief Operating Officer at the U.S. Agency for International Development and worked at the U.S. Department of State.", "extractions": [{"extraction_class": "person", "extraction_text": "Max Primorac", "attributes": {"role": "acting Chief Operating Officer"}}, {"extraction_class": "government_agency", "extraction_text": "U.S. Agency for International Development", "attributes": {"level": "federal", "acronym": "USAID"}}, {"extraction_class": "government_agency", "extraction_text": "U.S. Department of State", "attributes": {"level": "federal"}}]}
{"id": "gs-017", "text": "Roger Severino served as director of the Office for Civil Rights at the U.S. Department of Health and Human Services (HHS) and later founded the HHS Accountability Project at the Ethics & Public Policy Center.", "extractions": [{"extraction_class": "person", "extraction_text": "Roger Severino", "attributes": {"role": "former director and founder"}}, {"extraction_class": "government_agency", "extraction_text": "Office for Civil Rights", "attributes": {"parent_agency": "U.S. Department of Health and Human Services"}}, {"extraction_class": "government_agency", "extraction_text": "U.S. Department of Health and Human Services", "attributes": {"level": "federal", "acronym": "HHS"}}, {"extraction_class": "policy_program", "extraction_text": "HHS Accountability Project", "attributes": {"parent_organization": "Ethics & Public Policy Center"}}, {"extraction_class": "organization", "extraction_text": "Ethics & Public Policy Center", "attributes": {"type": "think tank"}}]}
{"id": "gs-018", "text": "Kiron K. Skinner served as Director of Policy Planning at the U.S. Department of State and was on the Defense Business Board at the U.S. Department of Defense.", "extractions": [{"extraction_class": "person", "extraction_text": "Kiron K. Skinner", "attributes": {"role": "Director of Policy Planning"}}, {"extraction_class": "government_agency", "extraction_text": "U.S. Department of State", "attributes": {"level": "federal"}}, {"extraction_class": "government_agency", "extraction_text": "Defense Business Board", "attributes": {"type": "advisory board"}}, {"extraction_class": "government_agency", "extraction_text": "U.S. Department of Defense", "attributes": {"level": "federal"}}]}
{"id": "gs-019", "text": "Brooks D. Tucker served in the U.S. Department of Veterans Affairs and advised Senator Richard Burr.", "extractions": [{"extraction_class": "person", "extraction_text": "Brooks D. Tucker", "attributes": {"role": "official"}}, {"extraction_class": "government_agency", "extraction_text": "U.S. Department of Veterans Affairs", "attributes": {"level": "federal", "acronym": "VA"}}, {"extraction_class": "person", "extraction_text": "Richard Burr", "attributes": {"role": "Senator"}}]}
{"id": "gs-020", "text": "Hans A. von Spakovsky was a Commissioner on the Federal Election Commission and served at the U.S. Department of Justice.", "extractions": [{"extraction_class": "person", "extraction_text": "Hans A. von Spakovsky", "attributes": {"role": "former Commissioner"}}, {"extraction_class": "government_agency", "extraction_text": "Federal Election Commission", "attributes": {"level": "federal", "type": "commission"}}, {"extraction_class": "government_agency", "extraction_text": "U.S. Department of Justice", "attributes": {"level": "federal", "type": "department"}}]}
{"id": "gs-021", "text": "Russ Vought served as Director of the Office of Management and Budget and led efforts in executive agencies.", "extractions": [{"extraction_class": "person", "extraction_text": "Russ Vought", "attributes": {"role": "Director of the Office of Management and Budget"}}, {"extraction_class": "government_agency", "extraction_text": "Office of Management and Budget", "attributes": {"level": "federal"}}]}
{"id": "gs-022", "text": "William L. Walton served on boards including The Heritage Foundation, American Enterprise Institute, and U.S. Chamber of Commerce.", "extractions": [{"extraction_class": "person", "extraction_text": "William L. Walton", "attributes": {"role": "board member"}}, {"extraction_class": "organization", "extraction_text": "The Heritage Foundation", "attributes": {"type": "think tank"}}, {"extraction_class": "organization", "extraction_text": "American Enterprise Institute", "attributes": {"type": "think tank"}}, {"extraction_class": "organization", "extraction_text": "U.S. Chamber of Commerce", "attributes": {"type": "business federation"}}]}
{"id": "gs-023", "text": "Paul Winfree led the team responsible for the Office of Management and Budget during the 2016 presidential transition.", "extractions": [{"extraction_class": "person", "extraction_text": "Paul Winfree", "attributes": {"role": "team leader"}}, {"extraction_class": "government_agency", "extraction_text": "Office of Management and Budget", "attributes": {"level": "federal"}}, {"extraction_class": "policy_program", "extraction_text": "2016 presidential transition", "attributes": {"type": "government transition"}}]}
{"id": "gs-024", "text": "Paul Dans is Director of the 2025 Presidential Transition Project at The Heritage Foundation and served at the U.S. Office of Personnel Management.", "extractions": [{"extraction_class": "person", "extraction_text": "Paul Dans", "attributes": {"role": "Director"}}, {"extraction_class": "policy_program", "extraction_text": "2025 Presidential Transition Project", "attributes": {"type": "transition project"}}, {"extraction_class": "organization", "extraction_text": "The Heritage Foundation", "attributes": {"role": "host organization"}}, {"extraction_class": "government_agency", "extraction_text": "U.S. Office of Personnel Management", "attributes": {"level": "federal agency"}}]}
{"id": "gs-025", "text": "Steven Groves served as Chief of Staff at the U.S. Mission to the United Nations and later as White House Deputy Press Secretary.", "extractions": [{"extraction_class": "person", "extraction_text": "Steven Groves", "attributes": {"role": "Chief of Staff, White House Deputy Press Secretary"}}, {"extraction_class": "government_agency", "extraction_text": "U.S. Mission to the United Nations", "attributes": {"type": "diplomatic mission"}}, {"extraction_class": "government_agency", "extraction_text": "White House", "attributes": {"level": "federal"}}]}
