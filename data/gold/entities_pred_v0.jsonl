{"id": "gs-028", "text": "The Constitution gives the executive Power to the President.", "extractions": [{"extraction_class": "legal_reference", "extraction_text": "Constitution", "attributes": {"kind": "foundational law"}}, {"extraction_class": "government_agency", "extraction_text": "President", "attributes": {"role": "head of the executive branch"}}]}
{"id": "gs-029", "text": "Beginning with George Washington, every President has been supported by a White House office and a Cabinet.", "extractions": [{"extraction_class": "person", "extraction_text": "George Washington", "attributes": {"role": "first President of the United States"}}, {"extraction_class": "government_agency", "extraction_text": "White House", "attributes": {"type": "executive office"}}, {"extraction_class": "government_agency", "extraction_text": "Cabinet", "attributes": {"type": "advisory body"}}]}
{"id": "gs-030", "text": "The Deputy Chief of Staff coordinates with the National Economic Council (NEC), the Domestic Policy Council (DPC), and the National Security Council (NSC).", "extractions": [{"extraction_class": "government_agency", "extraction_text": "Deputy Chief of Staff", "attributes": {"role": "coordination"}}, {"extraction_class": "government_agency", "extraction_text": "National Economic Council (NEC)", "attributes": {"focus": "economic policy", "level": "federal"}}, {"extraction_class": "government_agency", "extraction_text": "Domestic Policy Council (DPC)", "attributes": {"focus": "domestic policy", "level": "federal"}}, {"extraction_class": "government_agency", "extraction_text": "National Security Council (NSC)", "attributes": {"focus": "national security", "level": "federal"}}]}
{"id": "gs-031", "text": "The Office of Legislative Affairs (OLA) has continued to serve as the liaison between the White House and Congress.", "extractions": [{"extraction_class": "government_agency", "extraction_text": "Office of Legislative Affairs (OLA)", "attributes": {"role": "liaison", "level": "federal"}}, {"extraction_class": "government_agency", "extraction_text": "White House", "attributes": {"branch": "executive"}}, {"extraction_class": "government_agency", "extraction_text": "Congress", "attributes": {"branch": "legislative"}}]}
{"id": "gs-032", "text": "The Office of White House Counsel works closely with the Department of Justice (DOJ) and the Attorney General.", "extractions": [{"extraction_class": "government_agency", "extraction_text": "Office of White House Counsel", "attributes": {"role": "legal advisory"}}, {"extraction_class": "government_agency", "extraction_text": "Department of Justice", "attributes": {"level": "federal"}}, {"extraction_class": "government_agency", "extraction_text": "DOJ", "attributes": {"type": "acronym"}}]}
